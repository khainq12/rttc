-    for (; it != niIt->second.end() && it->first < Simulator::Now(); ++it)
+    for (; it != niIt->second.end() && it->first < now; ++it)
     {
         if (IsSameMuMimoTransmission(event, it->second.GetEvent()) &&
             (event != it->second.GetEvent()))
@@ -467,14 +474,23 @@ InterferenceHelper::CalculateNoiseInterferenceW(Ptr<Event> event,
     {
         ;
     }
-    NiChanges ni;
+    // P2 BACKPORT (upstream 90f347116, "wifi: Avoid unnecessary copy in
+    // InterferenceHelper::CalculateNoiseInterferenceW", 2025-06-06, post-3.41):
+    // build the NiChanges entry directly in its final map slot instead of
