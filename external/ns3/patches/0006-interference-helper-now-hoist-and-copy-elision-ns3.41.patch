+    // insert(). Safe here specifically because every call site in this file
+    // (CalculatePayloadSnrPer/CalculateSnr/CalculatePhyHeaderSnrPer) always
+    // passes a freshly-default-constructed, empty `nis` -- so nis[band]
+    // (create-if-absent) and the original nis.insert({band, ni})
+    // (no-op-if-band-already-present) are observationally identical for
+    // every actual call in this codebase; verified by reading all 3 callers.
+    auto& ni = nis[band];
     ni.emplace(event->GetStartTime(), NiChange(0, event));
     while (++it != niIt->second.end() && it->second.GetEvent() != event)
     {
         ni.insert(*it);
     }
     ni.emplace(event->GetEndTime(), NiChange(0, event));
-    nis.insert({band, ni});
     NS_ASSERT_MSG(noiseInterferenceW >= 0.0,
                   "CalculateNoiseInterferenceW returns negative value " << noiseInterferenceW);
     return noiseInterferenceW;
