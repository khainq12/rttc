+    TableBasedErrorRateModelCacheKey cacheKey{mode.GetUid(), ldpc, roundedSnr, size};
+    if (auto cached = m_chunkSuccessRateCache.find(cacheKey);
+        cached != m_chunkSuccessRateCache.end())
