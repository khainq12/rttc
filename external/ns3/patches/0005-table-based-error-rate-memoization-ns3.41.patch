diff --git a/src/wifi/model/table-based-error-rate-model.h b/src/wifi/model/table-based-error-rate-model.h
index 078d3ab..bcd56da 100644
--- a/src/wifi/model/table-based-error-rate-model.h
+++ b/src/wifi/model/table-based-error-rate-model.h
@@ -26,13 +26,55 @@
 
 #include "ns3/error-rate-tables.h"
 
+#include <cstddef>
+#include <cstdint>
 #include <optional>
+#include <unordered_map>
 
 namespace ns3
 {
 
 class WifiTxVector;
 
+/**
+ * P2 EXPERIMENT (rttc benchmark, not upstream ns-3): cache key for
+ * TableBasedErrorRateModel's per-call table lookup+interpolation. See
+ * DoGetChunkSuccessRate()'s own comment in the .cc file for the proof that
+ * this exact tuple is the complete set of the (non-fallback path's) inputs
+ * that can affect its return value -- caching on anything less would risk
+ * collisions, and this includes everything that reaches the actual
+ * computation once RoundSnr()'s own pre-existing quantization is applied.
+ */
+struct TableBasedErrorRateModelCacheKey
+{
+    uint32_t modeUid;   //!< WifiMode::GetUid() -- determines MCS/HT-remap deterministically
+    bool ldpc;          //!< txVector.IsLdpc()
+    double roundedSnr;  //!< RoundSnr(RatioToDb(snr), SNR_PRECISION) -- see DoGetChunkSuccessRate
+    uint64_t size;      //!< std::max<uint64_t>(1, nbits / 8)
+
+    bool operator==(const TableBasedErrorRateModelCacheKey& other) const
+    {
+        return modeUid == other.modeUid && ldpc == other.ldpc &&
+               roundedSnr == other.roundedSnr && size == other.size;
+    }
+};
+
+/// Hash functor for TableBasedErrorRateModelCacheKey.
+struct TableBasedErrorRateModelCacheKeyHash
+{
+    std::size_t operator()(const TableBasedErrorRateModelCacheKey& k) const noexcept
+    {
+        std::size_t seed = std::hash<uint32_t>{}(k.modeUid);
+        auto combine = [&seed](std::size_t h) {
+            seed ^= h + 0x9e3779b9 + (seed << 6) + (seed >> 2);
+        };
+        combine(std::hash<bool>{}(k.ldpc));
+        combine(std::hash<double>{}(k.roundedSnr));
+        combine(std::hash<uint64_t>{}(k.size));
+        return seed;
+    }
+};
+
 /*
  * \ingroup wifi
  * \brief the interface for the table-driven OFDM error model
@@ -89,6 +131,23 @@ class TableBasedErrorRateModel : public ErrorRateModel
         m_fallbackErrorModel; //!< Error rate model to fallback to if no value is found in the table
 
     uint64_t m_threshold; //!< Threshold in bytes over which the table for large size frames is used
+
+    /**
+     * P2 EXPERIMENT (rttc benchmark, not upstream ns-3): memoizes
+     * DoGetChunkSuccessRate()'s table-lookup-branch result (never the
+     * fallback-model branch, which is always recomputed exactly as before).
+     * `mutable` because the cache is a pure performance side channel on an
+     * otherwise-const query method -- see the .cc file for the full
+     * thread-safety and exactness argument. Capped (kMaxCacheEntries) and
+     * cleared wholesale on overflow rather than evicting piecemeal: this
+     * benchmark's static topology gives a small, stable key space in
+     * practice, so overflow is not expected to occur, and a wholesale clear
+     * is simplest to prove never returns a stale/wrong entry.
+     */
+    mutable std::unordered_map<TableBasedErrorRateModelCacheKey,
+                               double,
+                               TableBasedErrorRateModelCacheKeyHash>
+        m_chunkSuccessRateCache;
 };
 
 } // namespace ns3
