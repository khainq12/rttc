+bool fleetqox_reload_client_crl_enabled() {
+  const auto *value =
+      std::getenv("FLEETQOX_GNUTLS_RELOAD_CLIENT_CRL_EACH_HANDSHAKE");
+  return value != nullptr && std::string_view{value} == "1";
+}
+
+// GnuTLS's gnutls_certificate_free_crls() + gnutls_certificate_set_x509_crl_file()
+// on a credentials object that has already been used for at least one prior
+// handshake has been observed (empirically, via an independent fresh
+// credentials object verifying the very same peer certificate against the
+// very same on-disk CRL file at the same instant and getting the opposite,
+// correct answer) to leave stale internal revocation state behind despite
+// reporting success. Rather than depend on in-place reload of a reused
+// credentials object, build a brand-new one on every handshake and swap it
+// into the session before verification -- a freshly allocated object cannot
+// carry over stale state from an earlier handshake. This only needs client
+// CA trust + the client CRL (verified above with the independent-object
+// test): gnutls_certificate_verify_peers3() does not consult the
+// credentials' own server certificate/key when validating the peer.
+// The swapped-in object is intentionally leaked for the process lifetime:
+// this reload path only exists for test/probe use
+// (FLEETQOX_GNUTLS_RELOAD_CLIENT_CRL_EACH_HANDSHAKE=1), where connection
+// counts are small and bounded, and gnutls_credentials_set() does not take
+// ownership -- freeing it would require tracking it past this session's
+// lifetime for no benefit in a short-lived test binary.
+int fleetqox_reload_client_crl(gnutls_session_t session) {
+  if (!fleetqox_reload_client_crl_enabled()) {
+    return 0;
+  }
+  const auto *client_crl = std::getenv("FLEETQOX_GNUTLS_CLIENT_CRL");
+  if (client_crl == nullptr || client_crl[0] == '\0') {
+    dprintf(STDERR_FILENO,
+            "FLEETQOX_PUBLIC_MTLS_CRL_RELOAD_FAILED reason=missing_path\n");
+    return GNUTLS_E_CERTIFICATE_ERROR;
+  }
+  const auto *client_ca = std::getenv("FLEETQOX_GNUTLS_CLIENT_CA");
+  if (client_ca == nullptr || client_ca[0] == '\0') {
+    dprintf(STDERR_FILENO,
+            "FLEETQOX_PUBLIC_MTLS_CRL_RELOAD_FAILED "
+            "reason=missing_ca_path\n");
+    return GNUTLS_E_CERTIFICATE_ERROR;
+  }
+  gnutls_certificate_credentials_t fresh_credentials;
+  if (gnutls_certificate_allocate_credentials(&fresh_credentials) < 0) {
+    dprintf(STDERR_FILENO,
+            "FLEETQOX_PUBLIC_MTLS_CRL_RELOAD_FAILED "
+            "reason=allocate_credentials_failed\n");
+    return GNUTLS_E_CERTIFICATE_ERROR;
+  }
+  if (gnutls_certificate_set_x509_trust_file(
+        fresh_credentials, client_ca, GNUTLS_X509_FMT_PEM) <= 0) {
+    dprintf(STDERR_FILENO,
+            "FLEETQOX_PUBLIC_MTLS_CRL_RELOAD_FAILED reason=invalid_ca\n");
+    gnutls_certificate_free_credentials(fresh_credentials);
+    return GNUTLS_E_CERTIFICATE_ERROR;
+  }
+  auto rv = gnutls_certificate_set_x509_crl_file(
+      fresh_credentials, client_crl, GNUTLS_X509_FMT_PEM);
+  if (rv <= 0) {
+    dprintf(STDERR_FILENO,
+            "FLEETQOX_PUBLIC_MTLS_CRL_RELOAD_FAILED "
+            "reason=invalid_crl result=%d\n",
+            rv);
+    gnutls_certificate_free_credentials(fresh_credentials);
+    return GNUTLS_E_CERTIFICATE_ERROR;
+  }
+  auto set_rv = gnutls_credentials_set(
+      session, GNUTLS_CRD_CERTIFICATE, fresh_credentials);
+  if (set_rv < 0) {
+    dprintf(STDERR_FILENO,
+            "FLEETQOX_PUBLIC_MTLS_CRL_RELOAD_FAILED "
+            "reason=credentials_set_failed result=%d\n",
+            set_rv);
+    gnutls_certificate_free_credentials(fresh_credentials);
+    return GNUTLS_E_CERTIFICATE_ERROR;
+  }
+  dprintf(STDERR_FILENO,
+          "FLEETQOX_PUBLIC_MTLS_CRL_RELOADED certificates=%d\n", rv);
+  return 0;
+}
