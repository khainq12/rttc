+namespace {
+constexpr std::array<uint8_t, 8> FLEETQOX_BACKEND_REQUEST_MAGIC{
+    'F', 'Q', 'B', 'E', '2', 'R', 'E', 'Q'};
+constexpr std::array<uint8_t, 8> FLEETQOX_BACKEND_RESPONSE_MAGIC{
+    'F', 'Q', 'B', 'E', '1', 'R', 'E', 'S'};
+constexpr size_t FLEETQOX_BACKEND_REQUEST_HEADER_SIZE = 76;
+constexpr size_t FLEETQOX_BACKEND_RESPONSE_HEADER_SIZE = 20;
+constexpr size_t FLEETQOX_BACKEND_MAX_RESPONSE_BYTES = 4 * 1024 * 1024;
+
+struct FleetQoxBackendResponse {
+  unsigned int status;
+  std::string content_type;
+  std::string body;
+};
+
+struct FleetQoxPathTelemetry {
+  bool rtt_initialized;
+  uint64_t smoothed_rtt_us;
+  uint64_t rttvar_us;
+  uint64_t stream_loss_count;
+  uint64_t cwnd_bytes;
+  uint64_t bytes_in_flight;
+  uint64_t pto_count;
+};
+
+void store_u32(uint8_t *dest, uint32_t value) {
+  dest[0] = static_cast<uint8_t>(value >> 24);
+  dest[1] = static_cast<uint8_t>(value >> 16);
+  dest[2] = static_cast<uint8_t>(value >> 8);
+  dest[3] = static_cast<uint8_t>(value);
+}
+
+void store_u64(uint8_t *dest, uint64_t value) {
+  for (size_t i = 0; i < 8; ++i) {
+    dest[i] = static_cast<uint8_t>(value >> (56 - i * 8));
+  }
+}
+
+uint32_t load_u32(const uint8_t *source) {
+  return static_cast<uint32_t>(source[0]) << 24 |
+         static_cast<uint32_t>(source[1]) << 16 |
+         static_cast<uint32_t>(source[2]) << 8 |
+         static_cast<uint32_t>(source[3]);
+}
+
+bool write_all(int fd, const uint8_t *data, size_t datalen) {
+  while (datalen != 0) {
+    auto written = write(fd, data, datalen);
+    if (written < 0 && errno == EINTR) {
+      continue;
+    }
+    if (written <= 0) {
+      return false;
+    }
+    data += static_cast<size_t>(written);
+    datalen -= static_cast<size_t>(written);
+  }
+  return true;
+}
+
+bool read_all(int fd, uint8_t *data, size_t datalen) {
+  while (datalen != 0) {
+    auto received = read(fd, data, datalen);
+    if (received < 0 && errno == EINTR) {
+      continue;
+    }
+    if (received <= 0) {
+      return false;
+    }
+    data += static_cast<size_t>(received);
+    datalen -= static_cast<size_t>(received);
+  }
+  return true;
+}
+
+size_t fleetqox_backend_max_body_bytes() {
+  constexpr size_t DEFAULT_MAX = 1024 * 1024;
+  auto value = std::getenv("FLEETQOX_STATE_BACKEND_MAX_BODY_BYTES");
+  if (value == nullptr || value[0] == '\0') {
+    return DEFAULT_MAX;
+  }
+  char *end = nullptr;
+  errno = 0;
+  auto parsed = std::strtoull(value, &end, 10);
+  if (errno != 0 || end == value || *end != '\0' || parsed == 0 ||
+      parsed > DEFAULT_MAX) {
+    return DEFAULT_MAX;
+  }
+  return static_cast<size_t>(parsed);
+}
+
+std::string fleetqox_configured_client_identity() {
+  auto required_uri =
+      std::getenv("FLEETQOX_GNUTLS_REQUIRED_CLIENT_URI_SAN");
+  if (required_uri == nullptr || required_uri[0] == '\0') {
+    return {};
+  }
+  std::string uri{required_uri};
+  auto prefix = std::getenv("FLEETQOX_GNUTLS_CLIENT_URI_PREFIX");
+  if (prefix != nullptr && prefix[0] != '\0') {
+    std::string_view prefix_view{prefix};
+    if (uri.starts_with(prefix_view) && uri.size() > prefix_view.size()) {
+      return uri.substr(prefix_view.size());
+    }
+    return {};
+  }
+  auto separator = uri.find_last_of('/');
+  if (separator == std::string::npos || separator + 1 == uri.size()) {
+    return {};
+  }
+  return uri.substr(separator + 1);
+}
