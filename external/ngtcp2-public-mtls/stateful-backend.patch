+std::optional<FleetQoxBackendResponse> fleetqox_backend_request(
+    const std::string_view &socket_path, const std::string_view &method,
+    const std::string_view &path, const std::string_view &client_identity,
+    const std::vector<uint8_t> &body,
+    const FleetQoxPathTelemetry &path_telemetry) {
+  if (socket_path.empty() || socket_path.size() >= sizeof(sockaddr_un::sun_path) ||
+      method.empty() || method.size() > 16 || path.empty() ||
+      path.size() > 16384 || client_identity.size() > 4096 ||
+      body.size() > fleetqox_backend_max_body_bytes()) {
+    return std::nullopt;
+  }
+  auto fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+  if (fd == -1) {
+    return std::nullopt;
+  }
+  timeval timeout{12, 0};
+  setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+  setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+  sockaddr_un address{};
+  address.sun_family = AF_UNIX;
+  std::memcpy(address.sun_path, socket_path.data(), socket_path.size());
+  address.sun_path[socket_path.size()] = '\0';
+  if (connect(fd, reinterpret_cast<sockaddr *>(&address), sizeof(address)) != 0) {
+    close(fd);
+    return std::nullopt;
+  }
+  std::array<uint8_t, FLEETQOX_BACKEND_REQUEST_HEADER_SIZE> request_header{};
+  std::copy(FLEETQOX_BACKEND_REQUEST_MAGIC.begin(),
+            FLEETQOX_BACKEND_REQUEST_MAGIC.end(), request_header.begin());
+  store_u32(request_header.data() + 8, static_cast<uint32_t>(method.size()));
+  store_u32(request_header.data() + 12, static_cast<uint32_t>(path.size()));
+  store_u32(request_header.data() + 16,
+            static_cast<uint32_t>(client_identity.size()));
+  store_u32(request_header.data() + 20, static_cast<uint32_t>(body.size()));
+  store_u32(request_header.data() + 24,
+            path_telemetry.rtt_initialized ? 1u : 0u);
+  store_u64(request_header.data() + 28, path_telemetry.smoothed_rtt_us);
+  store_u64(request_header.data() + 36, path_telemetry.rttvar_us);
+  store_u64(request_header.data() + 44, path_telemetry.stream_loss_count);
+  store_u64(request_header.data() + 52, path_telemetry.cwnd_bytes);
+  store_u64(request_header.data() + 60, path_telemetry.bytes_in_flight);
+  store_u64(request_header.data() + 68, path_telemetry.pto_count);
+  auto ok = write_all(fd, request_header.data(), request_header.size()) &&
+            write_all(fd, reinterpret_cast<const uint8_t *>(method.data()),
+                      method.size()) &&
+            write_all(fd, reinterpret_cast<const uint8_t *>(path.data()),
+                      path.size()) &&
+            write_all(fd,
+                      reinterpret_cast<const uint8_t *>(client_identity.data()),
+                      client_identity.size()) &&
+            write_all(fd, body.data(), body.size());
+  std::array<uint8_t, FLEETQOX_BACKEND_RESPONSE_HEADER_SIZE> response_header{};
+  ok = ok && read_all(fd, response_header.data(), response_header.size());
+  if (!ok ||
+      !std::equal(FLEETQOX_BACKEND_RESPONSE_MAGIC.begin(),
+                  FLEETQOX_BACKEND_RESPONSE_MAGIC.end(),
+                  response_header.begin())) {
+    close(fd);
+    return std::nullopt;
+  }
+  auto status = load_u32(response_header.data() + 8);
+  auto content_type_length = load_u32(response_header.data() + 12);
+  auto body_length = load_u32(response_header.data() + 16);
+  if (status < 100 || status > 599 || content_type_length > 4096 ||
+      body_length > FLEETQOX_BACKEND_MAX_RESPONSE_BYTES) {
+    close(fd);
+    return std::nullopt;
+  }
+  FleetQoxBackendResponse response{
+      status, std::string(content_type_length, '\0'),
+      std::string(body_length, '\0')};
+  ok = read_all(fd, reinterpret_cast<uint8_t *>(response.content_type.data()),
+                response.content_type.size()) &&
+       read_all(fd, reinterpret_cast<uint8_t *>(response.body.data()),
+                response.body.size());
+  close(fd);
+  if (!ok) {
+    return std::nullopt;
+  }
+  return response;
+}
