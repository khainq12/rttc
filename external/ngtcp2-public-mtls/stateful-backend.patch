+int Stream::send_backend_response(nghttp3_conn *httpconn,
+                                  unsigned int status_code,
+                                  const std::string_view &content_type,
+                                  std::string body) {
+  status_resp_body = std::move(body);
+  auto status_code_str = util::format_uint(status_code);
+  auto content_length_str = util::format_uint(status_resp_body.size());
+  auto response_content_type =
+      content_type.empty() ? "application/octet-stream"sv : content_type;
+  std::array<nghttp3_nv, 4> nva{
+      util::make_nv_nc(":status"sv, status_code_str),
+      util::make_nv_nn("server"sv, "fleetrmw-public-ngtcp2/1"sv),
+      util::make_nv_nc("content-type"sv, response_content_type),
+      util::make_nv_nc("content-length"sv, content_length_str),
+  };
+  data = reinterpret_cast<uint8_t *>(status_resp_body.data());
+  datalen = status_resp_body.size();
+  nghttp3_data_reader dr{};
+  dr.read_data = read_data;
+  if (!config.quiet) {
+    debug::print_http_response_headers(stream_id, nva.data(), nva.size());
+  }
+  if (auto rv = nghttp3_conn_submit_response(
+          httpconn, stream_id, nva.data(), nva.size(), &dr);
+      rv != 0) {
+    std::cerr << "nghttp3_conn_submit_response: " << nghttp3_strerror(rv)
+              << std::endl;
+    return -1;
+  }
+  return 0;
+}
