+namespace {
+std::string fleetqox_hex_encode(const unsigned char *bytes, size_t size) {
+  std::ostringstream out;
+  out << std::hex << std::setfill('0');
+  for (size_t i = 0; i < size; ++i) {
+    out << std::setw(2) << static_cast<unsigned int>(bytes[i]);
+  }
+  return out.str();
+}
+} // namespace
+
+// Extracts the verified peer certificate's serial number as a lowercase
+// hex string, computed the same way fleetqox_verified_client_identity()
+// extracts the SAN identity above (same gnutls_certificate_get_peers()
+// entry point, called once per completed handshake). Used to recognize
+// a specific already-connected client against a freshly reloaded CRL's
+// revoked-serial list, since the CRL only ever carries serial numbers.
+std::string fleetqox_client_certificate_serial_hex(gnutls_session_t session) {
+  unsigned int peer_count = 0;
+  const auto *peers = gnutls_certificate_get_peers(session, &peer_count);
+  if (peers == nullptr || peer_count == 0) {
+    return {};
+  }
+  gnutls_x509_crt_t certificate;
+  if (gnutls_x509_crt_init(&certificate) < 0) {
+    return {};
+  }
+  if (gnutls_x509_crt_import(certificate, &peers[0], GNUTLS_X509_FMT_DER) <
+      0) {
+    gnutls_x509_crt_deinit(certificate);
+    return {};
+  }
+  std::array<unsigned char, 64> serial{};
+  size_t serial_size = serial.size();
+  auto rv =
+      gnutls_x509_crt_get_serial(certificate, serial.data(), &serial_size);
+  gnutls_x509_crt_deinit(certificate);
+  if (rv < 0) {
+    return {};
+  }
+  return fleetqox_hex_encode(serial.data(), serial_size);
+}
+
+// Parses the CRL file directly (rather than relying on
+// gnutls_certificate_set_x509_crl_file(), which folds revocation
+// checking into gnutls_certificate_verify_peers3() without exposing the
+// underlying serial list) to get a plain set of revoked serials that
+// already-established connections' cached peer certificates can be
+// checked against without repeating a full handshake-time chain
+// verification for each one.
+std::set<std::string> fleetqox_revoked_serials_from_crl_file(
+    const std::string &path) {
+  std::set<std::string> revoked;
+  if (path.empty()) {
+    return revoked;
+  }
+  gnutls_datum_t data{};
+  if (gnutls_load_file(path.c_str(), &data) < 0) {
+    return revoked;
+  }
+  gnutls_x509_crl_t crl;
+  if (gnutls_x509_crl_init(&crl) < 0) {
+    gnutls_free(data.data);
+    return revoked;
+  }
+  if (gnutls_x509_crl_import(crl, &data, GNUTLS_X509_FMT_PEM) < 0) {
+    gnutls_x509_crl_deinit(crl);
+    gnutls_free(data.data);
+    return revoked;
+  }
+  gnutls_free(data.data);
+  auto count = gnutls_x509_crl_get_crt_count(crl);
+  for (int index = 0; index < count; ++index) {
+    std::array<unsigned char, 64> serial{};
+    size_t serial_size = serial.size();
+    time_t revocation_time = 0;
+    if (gnutls_x509_crl_get_crt_serial(
+            crl, static_cast<unsigned>(index), serial.data(), &serial_size,
+            &revocation_time) < 0) {
+      continue;
+    }
+    revoked.insert(fleetqox_hex_encode(serial.data(), serial_size));
+  }
+  gnutls_x509_crl_deinit(crl);
+  return revoked;
+}
