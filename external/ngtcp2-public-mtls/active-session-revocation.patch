+// Called after the online CRL reload path (see
+// tls_server_context_gnutls.cc) successfully reloads a fresh CRL, so a
+// certificate revoked while its connection is already established is
+// torn down on the next reload rather than staying trusted for the rest
+// of that connection's lifetime -- previously only new connections
+// consulted the reloaded CRL at all.
+//
+// handlers_ maps each of a connection's several CIDs (client-initial
+// DCID plus every SCID) to the SAME Handler pointer, so the matching
+// step below deduplicates by pointer before closing anything: calling
+// force_close_for_revocation() then remove() twice on the same Handler
+// would delete it twice.
+void Server::close_connections_with_revoked_certificates(
+    const std::string &crl_path) {
+  auto revoked = fleetqox_revoked_serials_from_crl_file(crl_path);
+  if (revoked.empty()) {
+    return;
+  }
+  std::set<Handler *> to_close;
+  for (auto &entry : handlers_) {
+    auto h = entry.second;
+    const auto &serial = h->client_certificate_serial_hex();
+    if (!serial.empty() && revoked.count(serial) > 0) {
+      to_close.insert(h);
+    }
+  }
+  for (auto h : to_close) {
+    std::cerr << "FLEETQOX_PUBLIC_MTLS_ACTIVE_SESSION_REVOKED serial="
+              << h->client_certificate_serial_hex() << std::endl;
+    auto rv = h->force_close_for_revocation();
+    if (rv != NETWORK_ERR_CLOSE_WAIT) {
+      remove(h);
+    }
+  }
+}
