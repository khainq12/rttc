+// Mirrors the existing error path in handle_expiry(): stash a transport
+// close error into last_error_ and drive the same handle_error() ->
+// (start_closing_period() -> send_conn_close()) sequence every other
+// forced-teardown path in this file already uses, rather than
+// introducing a second way to tear down a connection.
+int Handler::force_close_for_revocation() {
+  ngtcp2_connection_close_error_set_transport_error_liberr(
+      &last_error_, NGTCP2_CONNECTION_REFUSED, nullptr, 0);
+  return handle_error();
+}
