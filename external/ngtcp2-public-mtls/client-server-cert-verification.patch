  */
 #include "tls_client_context_gnutls.h"
 
+#include <cstdio>
 #include <iostream>
+#include <unistd.h>
 
 #include <ngtcp2/ngtcp2_crypto_gnutls.h>
 
@@ -35,6 +37,30 @@
 
 extern Config config;
 
+namespace {
+
+// Upstream gtlsclient never verifies the server's certificate at all (no
+// gnutls_certificate_set_verify_function is ever registered on the client
+// side) -- it completes the TLS handshake and proceeds regardless of
+// whether the server's certificate chains to anything the client trusts.
+// This opt-in check (--verify-server-cert) adds that verification without
+// changing default behavior for any other probe that already relies on
+// the unverified default.
+int fleetqox_verify_server_certificate(gnutls_session_t session) {
+  unsigned int status = 0;
+  auto rv = gnutls_certificate_verify_peers3(session, nullptr, &status);
+  if (rv < 0 || status != 0) {
+    dprintf(STDERR_FILENO,
+            "FLEETQOX_PUBLIC_MTLS_CLIENT_SERVER_CERT_REJECTED status=%u\n",
+            status);
+    return GNUTLS_E_CERTIFICATE_ERROR;
+  }
+  dprintf(STDERR_FILENO, "FLEETQOX_PUBLIC_MTLS_CLIENT_SERVER_CERT_VERIFIED\n");
+  return 0;
+}
+
+} // namespace
+
 TLSClientContext::TLSClientContext() : cred_{nullptr} {}
 
 TLSClientContext::~TLSClientContext() {
@@ -70,5 +96,10 @@ int TLSClientContext::init(const char *private_key_file,
     }
   }
 
+  if (config.verify_server_cert) {
+    gnutls_certificate_set_verify_function(cred_,
+                                           fleetqox_verify_server_certificate);
+  }
+
   return 0;
 }
